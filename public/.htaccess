# Configuración para Hostinger (Apache/LiteSpeed)
# Este archivo asegura que React Router y la API PHP funcionen correctamente

RewriteEngine On
RewriteBase /

# Si la petición es para la API, no la redirijas a index.html
RewriteRule ^api/ - [L]

# Renderizar metadatos dinámicos para posts del blog
RewriteRule ^blog/([^/]+)/?$ blog.php?slug=$1 [L,QSA]

# Si el archivo o directorio existe físicamente, úsalo directamente
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Redirigir todas las demás peticiones a index.html (SPA routing)
RewriteRule ^ index.html [L]

# Política de cache: HTML y PHP siempre frescos
<IfModule mod_headers.c>
    <FilesMatch "^(index\.html|blog\.php)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
    </FilesMatch>

    <FilesMatch "\.(html)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
    </FilesMatch>

    <FilesMatch "\.(css|js|mjs|svg|png|jpg|jpeg|gif|webp|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# Desactivar cache para respuestas PHP
<FilesMatch "\.(php)$">
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
</FilesMatch>
